{
  "name": "tampere-targets",
  "version": "1.8.1",
  "private": true,
  "description": "Personal Tampere rental finder: Oikotie capture, local SQLite database, map UI",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "capture": "node src/capture/build.mjs",
    "import": "node src/import.mjs",
    "rebuild": "node src/rebuild.mjs",
    "list": "node src/cli.mjs list window",
    "report": "node src/report.mjs",
    "infra": "node src/infra.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "ui": "vite build --config web/vite.config.mjs && node server/index.mjs",
    "ui:build": "vite build --config web/vite.config.mjs",
    "ui:dev": "node server/dev.mjs",
    "deploy": "node deploy/index.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "vite": "8.3.7"
  }
}
